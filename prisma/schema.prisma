generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InstallationStatus {
  INSTALLED
  UNINSTALLED
  REDACTED
}

enum Plan {
  FREE
  PRO
}

enum SubscriptionStatus {
  UNKNOWN
  ACTIVE
  CANCEL_AT_PERIOD_END
  FROZEN
  CANCELLED
}

enum BundleStatus {
  DRAFT
  ACTIVE
}

enum PricingMode {
  FIXED
  DYNAMIC
}

enum WebhookState {
  PENDING
  PROCESSED
  FAILED
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
  @@index([expires])
}

model Shop {
  id                        String             @id @default(uuid()) @db.Uuid
  shopGid                   String?            @unique
  domain                    String             @unique
  currencyCode              String?
  storefrontTexts           Json
  storefrontTextVersion     Int                @default(1)
  installationStatus        InstallationStatus @default(INSTALLED)
  eligibleForBundles        Boolean            @default(false)
  ineligibilityReason       String?
  onlineStorePublicationGid String?
  cartTransformGid          String?
  installedAt               DateTime           @default(now())
  uninstalledAt             DateTime?
  redactedAt                DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  entitlement               ShopEntitlement?
  bundles                   Bundle[]
  webhookDeliveries         WebhookDelivery[]
}

model ShopEntitlement {
  shopId                String             @id @db.Uuid
  plan                  Plan               @default(FREE)
  subscriptionStatus    SubscriptionStatus @default(UNKNOWN)
  planHandle            String?
  partnerSubscriptionId String?
  confirmedAt           DateTime?
  graceUntil            DateTime?
  pendingPlan           Plan?
  pendingEffectiveAt    DateTime?
  billingPolledAt       DateTime?
  quotaEnforcedAt       DateTime?
  version               Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  shop                  Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([plan, billingPolledAt])
  @@index([plan, quotaEnforcedAt])
  @@index([pendingPlan, pendingEffectiveAt])
}

model Bundle {
  id               String           @id @default(uuid()) @db.Uuid
  shopId           String           @db.Uuid
  publicId         String           @default(cuid())
  pricingMode      PricingMode      @default(FIXED)
  discountPercent  Decimal          @default(0) @db.Decimal(5, 2)
  status           BundleStatus     @default(DRAFT)
  parentProductGid String
  parentVariantGid String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  shop             Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  selectors        BundleSelector[]

  @@unique([shopId, publicId])
  @@unique([shopId, parentProductGid])
  @@unique([shopId, parentVariantGid])
  @@index([shopId, status])
  @@index([shopId, updatedAt, id])
}

model BundleSelector {
  id              String                @id @default(uuid()) @db.Uuid
  bundleId        String                @db.Uuid
  selectorKey     Int
  position        Int
  productGid      String
  quantity        Int                   @default(1)
  discountPercent Decimal               @default(0) @db.Decimal(5, 2)
  bundle          Bundle                @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  options         BundleVariantOption[]

  @@unique([bundleId, selectorKey])
  @@unique([bundleId, position])
  @@index([productGid])
}

model BundleVariantOption {
  id         String         @id @default(uuid()) @db.Uuid
  selectorId String         @db.Uuid
  position   Int
  variantGid String
  selector   BundleSelector @relation(fields: [selectorId], references: [id], onDelete: Cascade)

  @@unique([selectorId, variantGid])
  @@index([variantGid])
}

model WebhookDelivery {
  id              String       @id @default(uuid()) @db.Uuid
  shopId          String?      @db.Uuid
  webhookId       String       @unique
  topic           String
  shopDomain      String
  payload         Json
  state           WebhookState @default(PENDING)
  attempts        Int          @default(0)
  processingToken String?
  lastError       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  processedAt     DateTime?
  shop            Shop?        @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([state, updatedAt])
  @@index([shopDomain])
}
