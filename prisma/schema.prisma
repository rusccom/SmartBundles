generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum InstallationStatus {
  INSTALLED
  UNINSTALLED
  REDACTED
}
enum Plan {
  FREE
  PRO
}
enum SubscriptionStatus {
  UNKNOWN
  ACTIVE
  CANCEL_AT_PERIOD_END
  FROZEN
  CANCELLED
}
enum BundleStatus {
  DRAFT
  PUBLISHING
  ACTIVE
  UPDATING
  PAUSING
  PAUSED
  NEEDS_ATTENTION
  FAILED
  ARCHIVED
}
enum BundleHealth {
  READY
  SOLD_OUT
  NEEDS_ATTENTION
}
enum RevisionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}
enum PricingMode {
  FIXED
  DYNAMIC
}
enum PublicationJobType {
  PUBLISH
  PAUSE
  RECONCILE
  DOWNGRADE
}
enum JobState {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}
enum WebhookState {
  PENDING
  PROCESSED
  FAILED
}
enum EditorSaveState {
  CLAIMED
  APPLYING
  VERIFYING
  RECOVERED
}
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
  @@index([shop])
  @@index([expires])
}
model Shop {
  id                        String             @id @default(uuid()) @db.Uuid
  shopGid                   String?            @unique
  domain                    String             @unique
  currencyCode              String?
  storefrontTexts           Json
  storefrontTextVersion     Int                @default(1)
  installationStatus        InstallationStatus @default(INSTALLED)
  eligibleForBundles        Boolean            @default(false)
  ineligibilityReason       String?
  onlineStorePublicationGid String?
  cartTransformGid          String?
  installedAt               DateTime           @default(now())
  uninstalledAt             DateTime?
  redactedAt                DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  entitlement               ShopEntitlement?
  bundles                   Bundle[]
  publicationJobs           PublicationJob[]
  outboxEvents              OutboxEvent[]
  webhookDeliveries         WebhookDelivery[]
}
model ShopEntitlement {
  shopId                String             @id @db.Uuid
  plan                  Plan               @default(FREE)
  subscriptionStatus    SubscriptionStatus @default(UNKNOWN)
  planHandle            String?
  partnerSubscriptionId String?
  confirmedAt           DateTime?
  graceUntil            DateTime?
  pendingPlan           Plan?
  pendingEffectiveAt    DateTime?
  billingPolledAt       DateTime?
  quotaEnforcedAt       DateTime?
  version               Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  shop                  Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@index([plan, billingPolledAt])
  @@index([plan, quotaEnforcedAt])
  @@index([pendingPlan, pendingEffectiveAt])
}
model Bundle {
  id                     String             @id @default(uuid()) @db.Uuid
  shopId                 String             @db.Uuid
  publicId               String             @default(cuid())
  pricingMode            PricingMode        @default(FIXED)
  fixedPrice             Decimal?           @db.Decimal(12, 2)
  discountPercent        Decimal            @default(0) @db.Decimal(5, 2)
  status                 BundleStatus       @default(DRAFT)
  health                 BundleHealth       @default(READY)
  countsTowardQuota      Boolean            @default(false)
  parentProductGid       String?
  parentVariantGid       String?
  activeRevision         Int?
  draftRevision          Int?
  activatedAt            DateTime?
  quotaRank              Int?
  runtimeEnabled         Boolean            @default(false)
  publishedVerified      Boolean            @default(false)
  lastErrorCode          String?
  lastErrorMessage       String?
  editorSaveToken        String?            @db.Uuid
  editorSaveStartedAt    DateTime?
  editorSaveState        EditorSaveState?
  editorSaveSettleAt     DateTime?
  editorSaveObservedHash String?
  editorSaveObservedAt   DateTime?
  lockVersion            Int                @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  shop                   Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  revisions              BundleRevision[]
  projection             ShopifyProjection?
  publicationJobs        PublicationJob[]
  @@unique([shopId, publicId])
  @@unique([shopId, parentProductGid])
  @@unique([shopId, parentVariantGid])
  @@index([shopId, status])
  @@index([shopId, countsTowardQuota])
  @@index([shopId, updatedAt, id])
  @@index([shopId, countsTowardQuota, quotaRank, activatedAt])
}
model BundleRevision {
  id                 String           @id @default(uuid()) @db.Uuid
  bundleId           String           @db.Uuid
  revision           Int
  runtimeConfig      Json?
  presentationConfig Json?
  runtimeBytes       Int              @default(0)
  runtimeHash        String?
  presentationHash   String?
  pricingMode        PricingMode      @default(FIXED)
  fixedPrice         Decimal?         @db.Decimal(12, 2)
  discountPercent    Decimal          @default(0) @db.Decimal(5, 2)
  parentPrice        Decimal          @db.Decimal(12, 2)
  status             RevisionStatus   @default(DRAFT)
  createdAt          DateTime         @default(now())
  bundle             Bundle           @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  selectors          BundleSelector[]
  @@unique([bundleId, revision])
  @@index([bundleId, status])
  @@index([createdAt])
}
model BundleSelector {
  id              String                @id @default(uuid()) @db.Uuid
  revisionId      String                @db.Uuid
  selectorKey     Int
  position        Int
  label           String
  productGid      String
  productTitle    String
  quantity        Int                   @default(1)
  discountPercent Decimal               @default(0) @db.Decimal(5, 2)
  revision        BundleRevision        @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  options         BundleVariantOption[]
  @@unique([revisionId, selectorKey])
  @@unique([revisionId, position])
  @@index([productGid])
}
model BundleVariantOption {
  id         String         @id @default(uuid()) @db.Uuid
  selectorId String         @db.Uuid
  position   Int
  variantGid String
  title      String
  imageUrl   String?
  available  Boolean        @default(true)
  unitPrice  Decimal?       @db.Decimal(12, 2)
  selector   BundleSelector @relation(fields: [selectorId], references: [id], onDelete: Cascade)
  @@unique([selectorId, variantGid])
  @@index([variantGid])
}
model ShopifyProjection {
  bundleId                String    @id @db.Uuid
  runtimeMetafieldId      String?
  runtimeDigest           String?
  runtimeHash             String?
  presentationMetafieldId String?
  presentationDigest      String?
  presentationHash        String?
  storefrontTextVersion   Int?
  productStatus           String?
  published               Boolean   @default(false)
  checkedAt               DateTime?
  updatedAt               DateTime  @updatedAt
  bundle                  Bundle    @relation(fields: [bundleId], references: [id], onDelete: Cascade)
}
model PublicationJob {
  id             String             @id @default(uuid()) @db.Uuid
  shopId         String             @db.Uuid
  bundleId       String?            @db.Uuid
  type           PublicationJobType
  state          JobState           @default(PENDING)
  step           String             @default("queued")
  attempts       Int                @default(0)
  nextAttemptAt  DateTime           @default(now())
  leaseUntil     DateTime?
  leaseToken     String?
  idempotencyKey String             @unique
  payload        Json?
  lastError      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  shop           Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bundle         Bundle?            @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  @@index([state, nextAttemptAt])
  @@index([state, updatedAt])
}
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  shopId      String    @db.Uuid
  topic       String
  payload     Json
  attempts    Int       @default(0)
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@index([deliveredAt, createdAt])
}
model WebhookDelivery {
  id              String       @id @default(uuid()) @db.Uuid
  shopId          String?      @db.Uuid
  webhookId       String       @unique
  topic           String
  shopDomain      String
  payload         Json
  state           WebhookState @default(PENDING)
  attempts        Int          @default(0)
  processingToken String?
  lastError       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  processedAt     DateTime?
  shop            Shop?        @relation(fields: [shopId], references: [id], onDelete: SetNull)
  @@index([state, updatedAt])
  @@index([shopDomain])
}
