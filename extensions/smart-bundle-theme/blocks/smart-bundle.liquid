<script src="{{ 'smart-bundle-core.js' | asset_url }}" type="module"></script>
<script src="{{ 'smart-bundle-form-guard.js' | asset_url }}" type="module"></script>
<script src="{{ 'smart-bundle-unavailable.js' | asset_url }}" type="module"></script>
<script src="{{ 'smart-bundle.js' | asset_url }}" type="module"></script>
<script src="{{ 'smart-bundle-cart-recovery.js' | asset_url }}" defer="defer"></script>

{%- assign bundle = product.metafields["$app"].bundle_presentation.value -%}
{%- assign parent_variant_gid = bundle.parentVariantId -%}
{%- assign parent_variant_id = parent_variant_gid | split: '/' | last -%}
{%- assign selector_count = bundle.selectors.size | default: 0 -%}
{%- assign pricing_mode = bundle.pricing.mode -%}
{%- assign pricing_valid = false -%}
{%- if pricing_mode == 'fixed' and bundle.pricing.amount != blank -%}
  {%- assign pricing_valid = true -%}
{%- elsif pricing_mode == 'dynamic' and bundle.pricing.maximumAmount != blank -%}
  {%- assign pricing_valid = true -%}
{%- endif -%}

{%- if bundle.sv == 2 and bundle.en == 1 and parent_variant_gid != blank and selector_count >= 1 and selector_count <= 150 and pricing_valid -%}
  {%- assign selected_count = 0 -%}
  {%- for selector in bundle.selectors -%}
    {%- assign only_option = selector.options.first -%}
    {%- if selector.options.size == 1 and only_option.available != false -%}
      {%- assign selected_count = selected_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign contextual_variant = product.selected_or_first_available_variant -%}
  {%- assign fixed_total = contextual_variant.price | money_with_currency -%}
  <smart-bundle
    class="sb"
    data-auto-mount="true"
    data-parent-variant-gid="{{ parent_variant_gid | escape }}"
    data-parent-variant-id="{{ parent_variant_id | escape }}"
    data-revision="{{ bundle.rv | json | escape }}"
    data-redirect-to-cart="{{ block.settings.redirect_to_cart }}"
    data-price-mode="{{ pricing_mode | escape }}"
    data-currency-code="{{ bundle.pricing.currencyCode | escape }}"
    data-maximum-amount="{{ bundle.pricing.maximumAmount | default: '' | escape }}"
    data-fixed-total="{{ fixed_total | escape }}"
    data-progress-template="{{ 'smart_bundle.progress' | t: selected: '__selected__', total: '__total__' | escape }}"
    data-select-one="{{ 'smart_bundle.select_one_more' | t | escape }}"
    data-select-many="{{ 'smart_bundle.select_many_more' | t: count: '__count__' | escape }}"
    data-choose-variant="{{ 'smart_bundle.choose_variant' | t | escape }}"
    data-included="{{ 'smart_bundle.included' | t | escape }}"
    data-price-unavailable="{{ 'smart_bundle.price_unavailable' | t | escape }}"
    data-option-unavailable="{{ 'smart_bundle.option_unavailable' | t | escape }}"
    data-bundle-unavailable="{{ 'smart_bundle.bundle_unavailable' | t | escape }}"
    data-adding-label="{{ 'smart_bundle.adding' | t | escape }}"
    data-added-label="{{ 'smart_bundle.added' | t | escape }}"
    data-added-status="{{ 'smart_bundle.added_status' | t | escape }}"
    data-add-error="{{ 'smart_bundle.add_error' | t | escape }}"
    data-add-label="{{ block.settings.button_label | escape }}"
    hidden
    {{ block.shopify_attributes }}
  >
    <div class="sb__heading">
      <h2 class="sb__title">{{ block.settings.heading | escape }}</h2>
      {%- if block.settings.show_progress -%}
        <span class="sb__progress" data-progress aria-live="polite">
          {{- 'smart_bundle.progress' | t: selected: selected_count, total: selector_count -}}
        </span>
      {%- endif -%}
    </div>

    <div class="sb__components" data-components>
      {%- for selector in bundle.selectors -%}
        {%- assign first_option = selector.options.first -%}
        {%- assign is_simple = false -%}
        {%- if selector.options.size == 1 -%}{%- assign is_simple = true -%}{%- endif -%}
        {%- assign initial_label = 'smart_bundle.choose_variant' | t -%}
        {%- if is_simple and first_option.available != false -%}
          {%- assign initial_label = first_option.title -%}
          {%- if initial_label == 'Default Title' -%}
            {%- assign initial_label = 'smart_bundle.included' | t -%}
          {%- endif -%}
        {%- elsif is_simple -%}
          {%- assign initial_label = 'smart_bundle.option_unavailable' | t -%}
        {%- endif -%}
        {%- capture summary_content -%}
          <span class="sb__media" data-image-wrap aria-hidden="true">
            {%- if first_option.imageUrl != blank -%}
              {% # theme-check-disable RemoteAsset %}
              <img class="sb__image" src="{{ first_option.imageUrl | escape }}" alt="" width="48" height="48" loading="lazy" data-image>
              {% # theme-check-enable RemoteAsset %}
            {%- else -%}
              <span class="sb__image-placeholder" data-image-placeholder></span>
            {%- endif -%}
          </span>
          <span class="sb__summary-copy">
            <strong class="sb__product-title">{{ selector.productTitle | escape }}</strong>
            <span class="sb__selection" data-selection-label>{{ initial_label | escape }}</span>
          </span>
          <span class="sb__summary-meta">
            <span class="sb__quantity">{{ 'smart_bundle.quantity' | t: quantity: selector.quantity }}</span>
            <span class="sb__line-price" data-line-price>
              {%- if pricing_mode == 'fixed' -%}{{ 'smart_bundle.included' | t }}{%- else -%}—{%- endif -%}
            </span>
          </span>
        {%- endcapture -%}
        <section
          class="sb__component"
          data-component
          data-selector-key="{{ selector.key | json | escape }}"
          data-quantity="{{ selector.quantity | escape }}"
          data-default-image="{{ first_option.imageUrl | default: '' | escape }}"
        >
          {%- if is_simple -%}
            <div class="sb__summary sb__summary--static">{{ summary_content }}</div>
            <input
              type="hidden"
              data-selector
              data-option-title="{{ initial_label | escape }}"
              data-image-url="{{ first_option.imageUrl | default: '' | escape }}"
              data-unit-price="{{ first_option.unitPrice | default: '' | escape }}"
              value="{% if first_option.available != false %}{{ first_option.id | escape }}{% endif %}"
            >
          {%- else -%}
            {%- assign panel_id = 'sb-panel-' | append: block.id | append: '-' | append: forloop.index -%}
            <button class="sb__summary sb__summary--button" type="button" data-disclosure aria-expanded="false" aria-controls="{{ panel_id }}">
              {{ summary_content }}<span class="sb__chevron" aria-hidden="true"></span>
            </button>
            <div class="sb__panel" id="{{ panel_id }}" data-panel hidden>
              <fieldset class="sb__options">
                <legend class="sb__visually-hidden">{{ 'smart_bundle.choose_variant_for' | t: product: selector.productTitle }}</legend>
                {%- for option in selector.options -%}
                  <label class="sb__option{% if option.available == false %} sb__option--sold-out{% endif %}">
                    <input
                      class="sb__option-input"
                      type="radio"
                      name="sb-{{ block.id }}-{{ selector.key }}"
                      value="{{ option.id | escape }}"
                      data-selector
                      data-option-title="{{ option.title | escape }}"
                      data-image-url="{{ option.imageUrl | default: '' | escape }}"
                      data-unit-price="{{ option.unitPrice | default: '' | escape }}"
                      {% if option.available == false %}disabled{% endif %}
                    >
                    <span class="sb__option-media" aria-hidden="true">
                      {%- if option.imageUrl != blank -%}
                        {% # theme-check-disable RemoteAsset %}
                        <img src="{{ option.imageUrl | escape }}" alt="" width="40" height="40" loading="lazy">
                        {% # theme-check-enable RemoteAsset %}
                      {%- else -%}<span class="sb__option-placeholder"></span>{%- endif -%}
                    </span>
                    <span class="sb__option-copy"><span>{{ option.title | escape }}</span>
                      {%- if option.available == false -%}<small>{{ 'smart_bundle.sold_out' | t }}</small>{%- endif -%}
                    </span>
                    <span class="sb__option-price" data-option-price></span>
                  </label>
                {%- endfor -%}
              </fieldset>
            </div>
          {%- endif -%}
        </section>
      {%- endfor -%}
    </div>

    <div class="sb__actions">
      <div class="sb__total-row">
        <span>{% if pricing_mode == 'fixed' %}{{ 'smart_bundle.bundle_price' | t }}{% else %}{{ 'smart_bundle.total' | t }}{% endif %}</span>
        <strong data-total>{% if pricing_mode == 'fixed' %}{{ fixed_total }}{% else %}—{% endif %}</strong>
      </div>
      {%- if pricing_mode == 'fixed' -%}<p class="sb__price-note">{{ 'smart_bundle.fixed_price_note' | t }}</p>{%- endif -%}
      <p class="sb__hint" data-hint aria-live="polite"></p>
      <p class="sb__status" data-status aria-live="polite"></p>
      <p class="sb__error" data-error role="alert" hidden></p>
      <button class="sb__button" type="button" data-add-button disabled aria-disabled="true">
        {{ block.settings.button_label | escape }}
      </button>
    </div>
  </smart-bundle>
  <noscript><p class="sb sb__editor-note">{{ 'smart_bundle.javascript_required' | t }}</p></noscript>
{%- elsif bundle != blank -%}
  <smart-bundle-unavailable
    class="sb"
    data-parent-variant-id="{{ product.selected_or_first_available_variant.id | escape }}"
    {{ block.shopify_attributes }}
  >
    <p class="sb__editor-note" role="status">{{ 'smart_bundle.bundle_unavailable' | t }}</p>
  </smart-bundle-unavailable>
{%- elsif request.design_mode -%}
  <div class="sb sb__editor-note" {{ block.shopify_attributes }}>{{ 'smart_bundle.editor_note' | t }}</div>
{%- endif -%}

{% schema %}
{
  "name": "Smart Bundle storefront",
  "target": "body",
  "stylesheet": "smart-bundle.css",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your bundle" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add bundle to cart" },
    { "type": "checkbox", "id": "show_progress", "label": "Show selection progress", "default": true },
    { "type": "checkbox", "id": "redirect_to_cart", "label": "Open the cart after adding", "default": true }
  ]
}
{% endschema %}
