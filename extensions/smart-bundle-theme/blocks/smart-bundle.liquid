<script src="{{ 'smart-bundle-core.js' | asset_url }}" type="module"></script>
<script src="{{ 'smart-bundle-markup.js' | asset_url }}" type="module"></script>
<script src="{{ 'smart-bundle-pricing.js' | asset_url }}" type="module"></script>
<script src="{{ 'smart-bundle-native-price.js' | asset_url }}" type="module"></script>
<script src="{{ 'smart-bundle-form-guard.js' | asset_url }}" type="module"></script>
<script src="{{ 'smart-bundle.js' | asset_url }}" type="module"></script>
<script src="{{ 'smart-bundle-cart-recovery.js' | asset_url }}" defer="defer"></script>

{%- assign bundle = product.metafields["$app"].bundle_presentation.value -%}

{%- if bundle != blank -%}
  <smart-bundle
    class="sb"
    data-auto-mount="true"
    data-block-id="{{ block.id | escape }}"
    data-locale="{{ request.locale.iso_code | escape }}"
    data-redirect-to-cart="{{ block.settings.redirect_to_cart }}"
    data-show-progress="{{ block.settings.show_progress }}"
    data-theme-variant-id="{{ product.selected_or_first_available_variant.id | escape }}"
    hidden
    {{ block.shopify_attributes }}
  >
    <script type="application/json" data-presentation>
      {{- bundle | json | replace: '</', '<\/' -}}
    </script>
  </smart-bundle>
  <noscript><p class="sb sb__editor-note">{{ bundle.texts.javascriptRequired | escape }}</p></noscript>
{%- elsif request.design_mode -%}
  <div class="sb sb__editor-note" {{ block.shopify_attributes }}>Publish a valid Smart Bundle with components to show this block.</div>
{%- endif -%}

{% schema %}
{
  "name": "Smart Bundle storefront",
  "target": "body",
  "stylesheet": "smart-bundle.css",
  "settings": [
    { "type": "checkbox", "id": "show_progress", "label": "Show selection progress", "default": true },
    { "type": "checkbox", "id": "redirect_to_cart", "label": "Open the cart after adding", "default": true }
  ]
}
{% endschema %}
