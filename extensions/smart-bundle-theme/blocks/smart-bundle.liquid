<script src="{{ 'smart-bundle-money.js' | asset_url }}" type="module"></script>
<script src="{{ 'smart-bundle-core.js' | asset_url }}" type="module"></script>
<script src="{{ 'smart-bundle-price.js' | asset_url }}" type="module"></script>
<script src="{{ 'smart-bundle-markup.js' | asset_url }}" type="module"></script>
<script src="{{ 'smart-bundle-pricing.js' | asset_url }}" type="module"></script>
<script src="{{ 'smart-bundle-form-guard.js' | asset_url }}" type="module"></script>
<script src="{{ 'smart-bundle-cart.js' | asset_url }}" type="module"></script>
<script src="{{ 'smart-bundle.js' | asset_url }}" type="module"></script>
<script src="{{ 'smart-bundle-cart-recovery.js' | asset_url }}" defer="defer"></script>

{%- assign bundle = product.metafields["$app"].bundle_presentation.value -%}

  {%- capture presentation -%}
    {%- assign parent_variant = product.selected_or_first_available_variant -%}
    {%- assign original_price = parent_variant.compare_at_price | default: parent_variant.price -%}
    {%- capture money_sample -%}
      {%- if settings.currency_code_enabled or settings.currency_code_enable -%}
        {{- 123456789 | money_with_currency | strip_html -}}
      {%- else -%}
        {{- 123456789 | money | strip_html -}}
      {%- endif -%}
    {%- endcapture -%}
    {
      "sv": {{ bundle.sv | json }}, "en": {{ bundle.en | json }},
      "b": {{ bundle.b | json }},
      "parentVariantId": {{ parent_variant.id | prepend: 'gid://shopify/ProductVariant/' | json }},
      "moneySample": {{ money_sample | json }},
      "pricing": {
        "mode": {{ bundle.pricing.mode | json }},
        "discountPercent": {{ bundle.pricing.discountPercent | json }},
        "currencyCode": {{ cart.currency.iso_code | json }},
        "amount": {{ parent_variant.price | divided_by: 100.0 | json }},
        "originalAmount": {{ original_price | divided_by: 100.0 | json }}
      },
      "selectors": {{ bundle.selectors | json }},
      "texts": {{ bundle.texts | json }},
      "catalog": [
        {%- assign variant_written = false -%}
        {%- for batch in (1..4) -%}
          {%- assign reference_key = 'bundle_variants_' | append: batch -%}
          {%- for variant in product.metafields["$app"][reference_key].value -%}
            {%- if variant_written -%},{%- endif -%}
            {%- assign component_product = variant.product -%}
            {%- assign component_image = variant.featured_image | default: component_product.featured_image -%}
            {
              "id": {{ variant.id | prepend: 'gid://shopify/ProductVariant/' | json }},
              "productId": {{ component_product.id | prepend: 'gid://shopify/Product/' | json }},
              "productTitle": {{ component_product.title | json }},
              "title": {{ variant.title | json }},
              "available": {{ variant.available | json }},
              "unitPrice": {{ variant.price | divided_by: 100.0 | json }},
              "imageUrl": {% if component_image %}{{ component_image | image_url: width: 160 | json }}{% else %}null{% endif %}
            }
            {%- assign variant_written = true -%}
          {%- endfor -%}
        {%- endfor -%}
      ]
    }
  {%- endcapture -%}
{%- if bundle != blank -%}
  <smart-bundle
    class="sb"
    data-auto-mount="true"
    data-block-id="{{ block.id | escape }}"
    data-locale="{{ request.locale.iso_code | escape }}"
    data-redirect-to-cart="{{ block.settings.redirect_to_cart }}"
    data-show-progress="{{ block.settings.show_progress }}"
    data-theme-variant-id="{{ product.selected_or_first_available_variant.id | escape }}"
    hidden
    {{ block.shopify_attributes }}
  >
    <script type="application/json" data-presentation>
      {{- presentation | replace: '</', '<\/' -}}
    </script>
  </smart-bundle>
  <noscript><p class="sb sb__editor-note">{{ bundle.texts.javascriptRequired | escape }}</p></noscript>
{%- elsif request.design_mode -%}
  <div class="sb sb__editor-note" {{ block.shopify_attributes }}>Publish a valid Smart Bundle with components to show this block.</div>
{%- endif -%}

{% schema %}
{
  "name": "Smart Bundle storefront",
  "target": "body",
  "stylesheet": "smart-bundle.css",
  "settings": [
    { "type": "checkbox", "id": "show_progress", "label": "Show selection progress", "default": true },
    { "type": "checkbox", "id": "redirect_to_cart", "label": "Open the cart after adding", "default": true }
  ]
}
{% endschema %}
