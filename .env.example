NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://smartbundle_app:replace_me@replace-me.aivencloud.com:00000/SmartBundles?sslmode=verify-full&sslrootcert=/run/secrets/aiven-ca.pem&connection_limit=10&pool_timeout=10
SHOPIFY_API_KEY=replace_me
SHOPIFY_API_SECRET=replace_me
SHOPIFY_APP_URL=https://bundles.example.com
SCOPES=read_products,write_products,read_cart_transforms,write_cart_transforms,read_publications,write_publications
SHOPIFY_APP_HANDLE=smartbundle
SHOPIFY_THEME_BLOCK_HANDLE=smart-bundle
SHOPIFY_BUNDLE_FUNCTION_HANDLE=smart-bundle-transform
SHOPIFY_PARTNER_ORG_ID=replace_me
SHOPIFY_PARTNER_APP_ID=replace_me
SHOPIFY_PARTNER_ACCESS_TOKEN=replace_me
SHOPIFY_PRO_PLAN_HANDLE=pro-monthly
SHOPIFY_PRICING_ENABLED=0
CRON_SECRET=replace_with_at_least_32_random_bytes
MAINTENANCE_WORKER_DISABLED=0
SMART_BUNDLE_WRITES_DISABLED=0
SMART_BUNDLE_ENABLE_V2_REPUBLISH=false
